<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      This file declares NO permissions at all. That is not the same as the app
      having none: Google Play's billing library merges in INTERNET,
      ACCESS_NETWORK_STATE and com.android.vending.BILLING, and androidx.biometric
      merges in USE_BIOMETRIC / USE_FINGERPRINT. Check the *merged* manifest, not
      this one, before repeating any claim about permissions:

        app/build/intermediates/merged_manifest/release/*/AndroidManifest.xml

      The app itself opens no connection — nothing in the vault, crypto,
      import/export or settings code touches a socket, and the billing client is
      reached only from the Upgrade screen.

      No location, contacts, camera or storage permission is declared or merged.
      File access for CSV import/export is done exclusively through the Storage
      Access Framework (ACTION_OPEN_DOCUMENT / ACTION_CREATE_DOCUMENT), which grants
      per-URI access without any broad storage permission.
    -->

    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".WalletApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflinePasswordWallet"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.OfflinePasswordWallet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Some androidx.activity versions ship this transparent activity with
          exported="true" (no intent-filter, so nothing can actually be done with
          it). Pin it closed so manifest security scanners stay quiet.
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:replace="android:exported" />

    </application>

</manifest>
