<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      NO android.permission.INTERNET is declared. This application is offline-only.
      It also declares no network, location, contacts, camera or storage permissions.
      File access for CSV import/export is done exclusively through the Storage
      Access Framework (ACTION_OPEN_DOCUMENT / ACTION_CREATE_DOCUMENT), which grants
      per-URI access without any broad storage permission.
    -->

    <uses-feature
        android:name="android.hardware.fingerprint"
        android:required="false" />

    <application
        android:name=".WalletApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.OfflinePasswordWallet"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:excludeFromRecents="false"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.OfflinePasswordWallet">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Some androidx.activity versions ship this transparent activity with
          exported="true" (no intent-filter, so nothing can actually be done with
          it). Pin it closed so manifest security scanners stay quiet.
        -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="false"
            tools:ignore="MissingClass"
            tools:replace="android:exported" />

    </application>

</manifest>
