<!--
  Offline Password Wallet launcher icon (background layer).

  A flat deep-green field with a subtle diagonal gradient. Fills the whole 108x108
  viewport, including the 18dp bleed each launcher mask may crop into.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF215C3F" android:offset="0" />
                <item android:color="#FF1B4332" android:offset="0.55" />
                <item android:color="#FF12301F" android:offset="1" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
