<?xml version="1.0" encoding="utf-8"?>
<!--
  Used on API >= 31. Disables both cloud backup and device-to-device transfer of
  all app data. The vault is intentionally NOT portable through OS backup; users
  move data explicitly via the (plaintext, clearly warned) CSV export instead.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
